# PocketSmith Developer API key: https://my.pocketsmith.com/security (Developer Keys)
POCKETSMITH_API_KEY=

# Path to a Google Cloud service account JSON key with the Sheets API enabled.
# Share your target Google Sheet with the service account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# The Google Sheet to sync with. Either the full ID (from the sheet URL) or the
# sheet's name (must be unique / already shared with the service account).
GOOGLE_SHEET_ID=
# GOOGLE_SHEET_NAME=PocketSmith Transactions

# Worksheet (tab) name to read/write within the spreadsheet.
SHEET_TAB_NAME=Transactions

# Optional: limit which transactions `pull` fetches. Leave blank to fetch everything.
SYNC_START_DATE=
SYNC_END_DATE=

# When true, `push` also marks successfully recategorised transactions as reviewed
# in PocketSmith (needs_review=false).
AUTO_MARK_REVIEWED=true
